// SPDX-License-Identifier: MIT
pragma solidity ^0.8.9;

contract DrugSupplyChain {

    // ============================================================
    // CONTRACT INFORMATION
    // ============================================================

    address public owner;
    string public contractName;
    string public contractVersion;

    constructor() {
        owner = msg.sender;
        contractName = "DrugSupplyChain";
        contractVersion = "1.1";
    }

    // ============================================================
    // ACCESS CONTROL
    // ============================================================

    modifier onlyOwner() {
        require(msg.sender == owner, "Not authorized");
        _;
    }

    // ============================================================
    // STRUCTS
    // ============================================================

    struct Manufacturer {
        uint manufacturerId;
        string location;
        string licenseNo;
        uint supplierId;
        uint govId;
    }

    struct Supplier {
        uint supplierId;
        string name;
        string location;
        string licenseNo;
        uint govId;
    }

    struct Distributor {
        uint distributorId;
        string name;
        string location;
        string licenseNo;
        uint manufacturerId;
    }

    struct Pharmacy {
        uint pharmacyId;
        string name;
        string location;
        string licenseNo;
        uint distributorId;
    }

    struct Customer {
        uint customerId;
        string name;
        string contactInfo;
        uint pharmacyId;
    }

    struct LotBatch {
        uint lotId;
        string drugName;
        uint quantity;
        string mfgDate;
        string expDate;
        uint manufacturerId;
    }

    struct Shipment {
        uint shipmentId;
        uint lotId;
        uint sourceId;
        uint destinationId;
        string shipDate;
        string status;
    }

    struct AuditLog {
        uint auditId;
        string entity;
        string action;
        string timestamp;
        uint userId;
    }

    // ============================================================
    // STORAGE MAPPINGS
    // ============================================================

    mapping(uint => Manufacturer) public manufacturers;
    mapping(uint => Supplier) public suppliers;
    mapping(uint => Distributor) public distributors;
    mapping(uint => Pharmacy) public pharmacies;
    mapping(uint => Customer) public customers;
    mapping(uint => LotBatch) public lots;
    mapping(uint => Shipment) public shipments;
    mapping(uint => AuditLog) public auditLogs;

    // ============================================================
    // EXISTENCE MAPPINGS
    // ============================================================

    mapping(uint => bool) public manufacturerExists;
    mapping(uint => bool) public supplierExists;
    mapping(uint => bool) public distributorExists;
    mapping(uint => bool) public pharmacyExists;
    mapping(uint => bool) public customerExists;
    mapping(uint => bool) public lotExists;
    mapping(uint => bool) public shipmentExists;
    mapping(uint => bool) public auditLogExists;

    // ============================================================
    // EVENTS
    // ============================================================

    event ManufacturerAdded(
        uint indexed manufacturerId,
        address indexed addedBy
    );

    event SupplierAdded(
        uint indexed supplierId,
        address indexed addedBy
    );

    event DistributorAdded(
        uint indexed distributorId,
        address indexed addedBy
    );

    event PharmacyAdded(
        uint indexed pharmacyId,
        address indexed addedBy
    );

    event CustomerAdded(
        uint indexed customerId,
        address indexed addedBy
    );

    event LotAdded(
        uint indexed lotId,
        address indexed addedBy
    );

    event ShipmentAdded(
        uint indexed shipmentId,
        address indexed addedBy
    );

    event AuditLogAdded(
        uint indexed auditId,
        address indexed addedBy
    );

    // ============================================================
    // MANUFACTURER
    // ============================================================

    function addManufacturer(
        uint _id,
        string memory _location,
        string memory _licenseNo,
        uint _supplierId,
        uint _govId
    )
        public
        onlyOwner
    {
        require(_id > 0, "Invalid manufacturer ID");
        require(!manufacturerExists[_id], "Manufacturer ID already exists");
        require(bytes(_location).length > 0, "Location required");
        require(bytes(_licenseNo).length > 0, "License number required");

        manufacturers[_id] = Manufacturer(
            _id,
            _location,
            _licenseNo,
            _supplierId,
            _govId
        );

        manufacturerExists[_id] = true;

        emit ManufacturerAdded(_id, msg.sender);
    }

    // ============================================================
    // SUPPLIER
    // ============================================================

    function addSupplier(
        uint _id,
        string memory _name,
        string memory _location,
        string memory _licenseNo,
        uint _govId
    )
        public
        onlyOwner
    {
        require(_id > 0, "Invalid supplier ID");
        require(!supplierExists[_id], "Supplier ID already exists");
        require(bytes(_name).length > 0, "Supplier name required");
        require(bytes(_location).length > 0, "Location required");
        require(bytes(_licenseNo).length > 0, "License number required");

        suppliers[_id] = Supplier(
            _id,
            _name,
            _location,
            _licenseNo,
            _govId
        );

        supplierExists[_id] = true;

        emit SupplierAdded(_id, msg.sender);
    }

    // ============================================================
    // DISTRIBUTOR
    // ============================================================

    function addDistributor(
        uint _id,
        string memory _name,
        string memory _location,
        string memory _licenseNo,
        uint _manufacturerId
    )
        public
        onlyOwner
    {
        require(_id > 0, "Invalid distributor ID");
        require(!distributorExists[_id], "Distributor ID already exists");
        require(bytes(_name).length > 0, "Distributor name required");
        require(bytes(_location).length > 0, "Location required");
        require(bytes(_licenseNo).length > 0, "License number required");

        distributors[_id] = Distributor(
            _id,
            _name,
            _location,
            _licenseNo,
            _manufacturerId
        );

        distributorExists[_id] = true;

        emit DistributorAdded(_id, msg.sender);
    }

    // ============================================================
    // PHARMACY
    // ============================================================

    function addPharmacy(
        uint _id,
        string memory _name,
        string memory _location,
        string memory _licenseNo,
        uint _distributorId
    )
        public
        onlyOwner
    {
        require(_id > 0, "Invalid pharmacy ID");
        require(!pharmacyExists[_id], "Pharmacy ID already exists");
        require(bytes(_name).length > 0, "Pharmacy name required");
        require(bytes(_location).length > 0, "Location required");
        require(bytes(_licenseNo).length > 0, "License number required");

        pharmacies[_id] = Pharmacy(
            _id,
            _name,
            _location,
            _licenseNo,
            _distributorId
        );

        pharmacyExists[_id] = true;

        emit PharmacyAdded(_id, msg.sender);
    }

    // ============================================================
    // CUSTOMER
    // ============================================================

    function addCustomer(
        uint _id,
        string memory _name,
        string memory _contactInfo,
        uint _pharmacyId
    )
        public
        onlyOwner
    {
        require(_id > 0, "Invalid customer ID");
        require(!customerExists[_id], "Customer ID already exists");
        require(bytes(_name).length > 0, "Customer name required");
        require(bytes(_contactInfo).length > 0, "Contact information required");

        customers[_id] = Customer(
            _id,
            _name,
            _contactInfo,
            _pharmacyId
        );

        customerExists[_id] = true;

        emit CustomerAdded(_id, msg.sender);
    }

    // ============================================================
    // LOT / BATCH
    // ============================================================

    function addLot(
        uint _lotId,
        string memory _drugName,
        uint _quantity,
        string memory _mfgDate,
        string memory _expDate,
        uint _manufacturerId
    )
        public
        onlyOwner
    {
        require(_lotId > 0, "Invalid lot ID");
        require(!lotExists[_lotId], "Lot ID already exists");
        require(_quantity > 0, "Quantity must be greater than zero");
        require(bytes(_drugName).length > 0, "Drug name required");
        require(bytes(_mfgDate).length > 0, "Manufacturing date required");
        require(bytes(_expDate).length > 0, "Expiry date required");

        lots[_lotId] = LotBatch(
            _lotId,
            _drugName,
            _quantity,
            _mfgDate,
            _expDate,
            _manufacturerId
        );

        lotExists[_lotId] = true;

        emit LotAdded(_lotId, msg.sender);
    }

    // ============================================================
    // SHIPMENT
    // ============================================================

    function addShipment(
        uint _shipmentId,
        uint _lotId,
        uint _sourceId,
        uint _destinationId,
        string memory _shipDate,
        string memory _status
    )
        public
        onlyOwner
    {
        require(_shipmentId > 0, "Invalid shipment ID");
        require(!shipmentExists[_shipmentId], "Shipment ID already exists");
        require(_lotId > 0, "Invalid lot ID");
        require(_sourceId > 0, "Invalid source ID");
        require(_destinationId > 0, "Invalid destination ID");
        require(bytes(_shipDate).length > 0, "Shipment date required");
        require(bytes(_status).length > 0, "Shipment status required");

        shipments[_shipmentId] = Shipment(
            _shipmentId,
            _lotId,
            _sourceId,
            _destinationId,
            _shipDate,
            _status
        );

        shipmentExists[_shipmentId] = true;

        emit ShipmentAdded(_shipmentId, msg.sender);
    }

    // ============================================================
    // AUDIT LOG
    // ============================================================

    function addAuditLog(
        uint _auditId,
        string memory _entity,
        string memory _action,
        string memory _timestamp,
        uint _userId
    )
        public
        onlyOwner
    {
        require(_auditId > 0, "Invalid audit ID");
        require(!auditLogExists[_auditId], "Audit ID already exists");
        require(bytes(_entity).length > 0, "Entity required");
        require(bytes(_action).length > 0, "Action required");
        require(bytes(_timestamp).length > 0, "Timestamp required");
        require(_userId > 0, "Invalid user ID");

        auditLogs[_auditId] = AuditLog(
            _auditId,
            _entity,
            _action,
            _timestamp,
            _userId
        );

        auditLogExists[_auditId] = true;

        emit AuditLogAdded(_auditId, msg.sender);
    }
}